# ──────────────────────────────────────────────
# MongoDB Atlas
# ──────────────────────────────────────────────
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/missing_person_ai?retryWrites=true&w=majority
DB_NAME=missing_person_ai

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────────
# File uploads
# ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ──────────────────────────────────────────────
# Face recognition
# ──────────────────────────────────────────────
# Distance threshold — lower is stricter (0.0–1.0).  Default: 0.6
FACE_DISTANCE_THRESHOLD=0.6
